  <script>
    // --- DATABASE MOCKUP (STORAGE) ---
    const defaultAccounts = [
      {
        username: "admin",
        password: "123",
        fullname: "ผู้ดูแลระบบ",
        email: "admin@example.com",
        role: "ผู้ดูแลระบบสูงสุด",
        dept: "ศูนย์เทคโนโลยีการศึกษา",
        phone: "0812345678",
        staffId: "STF-2026-009"
      }
    ];

    function getStoredUsers() {
      const users = localStorage.getItem('hygin_users');
      return users ? JSON.parse(users) : defaultAccounts;
    }

    function saveStoredUsers(users) {
      localStorage.setItem('hygin_users', JSON.stringify(users));
    }

    // Initialize users on first load
    if (!localStorage.getItem('hygin_users')) {
      saveStoredUsers(defaultAccounts);
    }

    let currentUser = null;
    let generatedOTP = null;
    let forgotUserTarget = null;

    // --- HELPER FUNCTIONS ---
    function toggleVisibility(inputId, iconElem) {
      const input = document.getElementById(inputId);
      if (input.type === "password") {
        input.type = "text";
        iconElem.textContent = "🙈";
      } else {
        input.type = "password";
        iconElem.textContent = "👁️";
      }
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }

    function showModal(modalId) {
      document.getElementById(modalId).classList.add('active');
    }

    function showToastOTP(code) {
      const toast = document.getElementById('otp-toast');
      document.getElementById('toast-otp-code').textContent = code;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 6000);
    }

    // --- LOGIN SYSTEM ---
    function handleLogin(e) {
      e.preventDefault();
      const userVal = document.getElementById('username').value.trim();
      const passVal = document.getElementById('login-pass').value;
      const errorDiv = document.getElementById('login-error');

      const users = getStoredUsers();
      const match = users.find(u => u.username === userVal && u.password === passVal);

      if (match) {
        currentUser = match;
        errorDiv.style.display = 'none';
        
        // Update Profile Data
        document.getElementById('display-name').textContent = currentUser.fullname;
        document.getElementById('display-username').textContent = currentUser.username;
        document.getElementById('display-role').textContent = currentUser.role || 'เจ้าหน้าที่';
        document.getElementById('display-dept').textContent = currentUser.dept || 'ศูนย์เทคโนโลยีการศึกษา';
        document.getElementById('display-phone').textContent = currentUser.phone || '0812345678';
        document.getElementById('display-staff-id').textContent = currentUser.staffId || 'STF-2026-010';
        document.getElementById('email-input').value = currentUser.email;

        // Remember exact password logged in & lock initial state (masked)
        const secPassInput = document.getElementById('sec-pass');
        secPassInput.value = currentUser.password;
        secPassInput.type = "password"; // ensure hidden as dots

        // Switch to App Screen
        document.getElementById('login-screen').classList.remove('active-screen');
        document.getElementById('app-screen').classList.add('active-screen');
      } else {
        errorDiv.textContent = 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง';
        errorDiv.style.display = 'block';
      }
    }

    function handleLogout() {
      currentUser = null;
      document.getElementById('login-form').reset();
      document.getElementById('login-error').style.display = 'none';
      document.getElementById('app-screen').classList.remove('active-screen');
      document.getElementById('login-screen').classList.add('active-screen');
    }

    // --- NAVIGATION ---
    function switchPage(pageKey, pageTitle) {
      document.querySelectorAll('.nav-btn.page-nav-btn').forEach(btn => {
        btn.classList.remove('active');
        if(btn.dataset.page === pageKey) btn.classList.add('active');
      });

      document.querySelectorAll('.page-content').forEach(panel => {
        panel.classList.remove('active');
      });
      document.getElementById(`page-${pageKey}`).classList.add('active');
      document.getElementById('page-title-display').textContent = pageTitle;
    }

    // --- REGISTER SYSTEM (NO OTP REQUIRED) ---
    function openRegisterModal() {
      document.getElementById('reg-fullname').value = '';
      document.getElementById('reg-username').value = '';
      document.getElementById('reg-email').value = '';
      document.getElementById('reg-pass').value = '';
      document.getElementById('reg-error').style.display = 'none';
      showModal('register-modal');
    }

    function handleRegister(e) {
      e.preventDefault();
      const fullname = document.getElementById('reg-fullname').value.trim();
      const username = document.getElementById('reg-username').value.trim();
      const email = document.getElementById('reg-email').value.trim();
      const password = document.getElementById('reg-pass').value;
      const errorDiv = document.getElementById('reg-error');

      const users = getStoredUsers();
      if (users.some(u => u.username === username)) {
        errorDiv.textContent = 'ชื่อผู้ใช้นี้มีในระบบแล้ว กรุณาใช้ชื่ออื่น';
        errorDiv.style.display = 'block';
        return;
      }

      const newUser = {
        username: username,
        password: password,
        fullname: fullname,
        email: email,
        role: "เจ้าหน้าที่ปฏิบัติการ",
        dept: "ศูนย์เทคโนโลยีการศึกษา",
        phone: "08" + Math.floor(10000000 + Math.random() * 90000000),
        staffId: "STF-2026-" + Math.floor(100 + Math.random() * 900)
      };

      users.push(newUser);
      saveStoredUsers(users);

      closeModal('register-modal');
      alert('ลงทะเบียนสำเร็จ! สามารถเข้าสู่ระบบด้วยชื่อผู้ใช้และรหัสผ่านใหม่ได้ทันที');

      // Pre-fill login
      document.getElementById('username').value = username;
      document.getElementById('login-pass').value = password;
    }

    // --- FORGOT PASSWORD SYSTEM VIA GMAIL & OTP ---
    function openForgotPasswordModal() {
      document.getElementById('forgot-step-1').style.display = 'block';
      document.getElementById('forgot-step-2').style.display = 'none';
      document.getElementById('forgot-step-3').style.display = 'none';
      document.getElementById('forgot-gmail').value = '';
      document.getElementById('forgot-error-1').style.display = 'none';
      document.getElementById('forgot-error-2').style.display = 'none';
      showModal('forgot-modal');
    }

    function sendForgotOTP() {
      const gmail = document.getElementById('forgot-gmail').value.trim();
      const errorDiv = document.getElementById('forgot-error-1');
      const users = getStoredUsers();

      const user = users.find(u => u.email.toLowerCase() === gmail.toLowerCase());

      if (!user) {
        errorDiv.textContent = 'ไม่พบอีเมล Gmail นี้ในระบบ กรุณาตรวจสอบอีกครั้ง';
        errorDiv.style.display = 'block';
        return;
      }

      forgotUserTarget = user;
      generatedOTP = Math.floor(100000 + Math.random() * 900000).toString();
      
      showToastOTP(generatedOTP);

      document.getElementById('forgot-step-1').style.display = 'none';
      document.getElementById('forgot-step-2').style.display = 'block';
      document.getElementById('forgot-otp-input').value = '';
    }

    function verifyForgotOTP() {
      const otpInput = document.getElementById('forgot-otp-input').value.trim();
      const errorDiv = document.getElementById('forgot-error-2');

      if (otpInput === generatedOTP) {
        document.getElementById('forgot-step-2').style.display = 'none';
        document.getElementById('forgot-step-3').style.display = 'block';
        document.getElementById('revealed-password').textContent = forgotUserTarget.password;
      } else {
        errorDiv.textContent = 'รหัส OTP ไม่ถูกต้อง กรุณาตรวจสอบจากป๊อปอัปแจ้งเตือน';
        errorDiv.style.display = 'block';
      }
    }

    // --- PROFILE ACTIONS ---
    function openPasswordModal() {
      document.getElementById('change-old-pass').value = '';
      document.getElementById('change-new-pass').value = '';
      document.getElementById('change-confirm-pass').value = '';
      document.getElementById('change-pass-error').style.display = 'none';
      document.getElementById('change-pass-success').style.display = 'none';
      showModal('password-modal');
    }

    function handleChangePassword(e) {
      e.preventDefault();
      const oldPass = document.getElementById('change-old-pass').value;
      const newPass = document.getElementById('change-new-pass').value;
      const confirmPass = document.getElementById('change-confirm-pass').value;
      const errDiv = document.getElementById('change-pass-error');
      const succDiv = document.getElementById('change-pass-success');

      errDiv.style.display = 'none';
      succDiv.style.display = 'none';

      if (oldPass !== currentUser.password) {
        errDiv.textContent = 'รหัสผ่านเดิมไม่ถูกต้อง';
        errDiv.style.display = 'block';
        return;
      }

      if (newPass !== confirmPass) {
        errDiv.textContent = 'รหัสผ่านใหม่ทั้งสองช่องไม่ตรงกัน';
        errDiv.style.display = 'block';
        return;
      }

      // Update in memory & database
      currentUser.password = newPass;
      const users = getStoredUsers();
      const idx = users.findIndex(u => u.username === currentUser.username);
      if (idx !== -1) {
        users[idx].password = newPass;
        saveStoredUsers(users);
      }

      // Sync display in Profile Section
      document.getElementById('sec-pass').value = newPass;

      succDiv.textContent = 'เปลี่ยนรหัสผ่านสำเร็จเรียบร้อยแล้ว';
      succDiv.style.display = 'block';

      setTimeout(() => {
        closeModal('password-modal');
      }, 1200);
    }

    function updateEmail() {
      const newEmail = document.getElementById('email-input').value.trim();
      const alertDiv = document.getElementById('email-alert');
      if (!newEmail) return;

      currentUser.email = newEmail;
      const users = getStoredUsers();
      const idx = users.findIndex(u => u.username === currentUser.username);
      if (idx !== -1) {
        users[idx].email = newEmail;
        saveStoredUsers(users);
      }

      alertDiv.textContent = 'บันทึกอีเมลเรียบร้อยแล้ว';
      alertDiv.className = 'alert-msg success';
      alertDiv.style.display = 'block';
      setTimeout(() => { alertDiv.style.display = 'none'; }, 2500);
    }

    function editProfile() {
      alert('เปิดโหมดแก้ไขข้อมูลโปรไฟล์ทั่วไป');
    }

    function loginWithSocial(provider) {
      alert(`ระบบล็อกอินด้วย ${provider} กำลังเชื่อมต่อกับบัญชีกลาง`);
    }
  </script>
</body>
</html>
